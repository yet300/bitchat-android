-- Geohash bookmarks (moves out of plaintext multiplatform-settings: geohash_bookmarks in
-- GeohashBookmarksRepositoryImpl). `position` preserves the newest-first ordering (lower = newer).
CREATE TABLE geohash_bookmark (
    geohash  TEXT    NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL
);

selectAll:
SELECT geohash FROM geohash_bookmark ORDER BY position ASC;

upsert:
INSERT OR REPLACE INTO geohash_bookmark(geohash, position) VALUES (?, ?);

deleteByGeohash:
DELETE FROM geohash_bookmark WHERE geohash = ?;

deleteAll:
DELETE FROM geohash_bookmark;
