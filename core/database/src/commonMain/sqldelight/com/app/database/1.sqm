-- Migration v1 -> v2: add the persistent send-outbox table.
-- Existing installs keep their `message` data; this only adds the new table. Fresh installs get it
-- from OutboxEnvelope.sq via Schema.create instead. The two definitions must stay identical.
CREATE TABLE outbox_envelope (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    peer_id       TEXT    NOT NULL,
    kind          TEXT    NOT NULL,
    payload_json  TEXT    NOT NULL,
    message_id    TEXT,
    created_at    INTEGER NOT NULL,
    expiry_at     INTEGER,
    attempts      INTEGER NOT NULL DEFAULT 0,
    recipient_tag BLOB,
    ciphertext    BLOB,
    copies        INTEGER,
    prekey_id     INTEGER
);

CREATE INDEX outbox_peer   ON outbox_envelope(peer_id, id);
CREATE INDEX outbox_expiry ON outbox_envelope(expiry_at);
