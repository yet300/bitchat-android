-- Message timeline (source of truth for the UI; replaces the in-memory AppStateStore timelines).
-- conversation_id uses the existing AppStateStore key scheme:
--   "public" | "private:<peerId>" | "channel:<tag>" | "geo:<geohash>"
CREATE TABLE message (
    id              TEXT    NOT NULL PRIMARY KEY,
    conversation_id TEXT    NOT NULL,
    sender_peer_id  TEXT,
    sender_name     TEXT    NOT NULL,
    content         TEXT    NOT NULL,
    timestamp       INTEGER NOT NULL,
    type            TEXT    NOT NULL,
    is_mine         INTEGER NOT NULL DEFAULT 0,
    is_relay        INTEGER NOT NULL DEFAULT 0,
    mentions        TEXT,
    delivery_status TEXT,
    attachment_path TEXT,
    attachment_type TEXT,
    pow_difficulty  INTEGER,
    channel         TEXT,
    -- Full serialized wire message (BitchatMessage JSON) — the lossless source for reconstruction.
    -- The columns above are the searchable projection of it.
    wire_json       TEXT
);

-- Indices the future indexed-search query (FIX_BACKLOG §C) will read. Search itself is NOT built here.
CREATE INDEX message_conversation ON message(conversation_id, timestamp);
CREATE INDEX message_sender       ON message(sender_peer_id);
CREATE INDEX message_timestamp    ON message(timestamp);
CREATE INDEX message_content      ON message(content);

selectByConversation:
SELECT * FROM message WHERE conversation_id = ? ORDER BY timestamp ASC;

selectById:
SELECT * FROM message WHERE id = ?;

selectConversationIds:
SELECT DISTINCT conversation_id FROM message;

selectRecentByConversation:
SELECT * FROM message WHERE conversation_id = ? ORDER BY timestamp DESC LIMIT ?;

upsert:
INSERT OR REPLACE INTO message(
    id, conversation_id, sender_peer_id, sender_name, content, timestamp, type,
    is_mine, is_relay, mentions, delivery_status, attachment_path, attachment_type,
    pow_difficulty, channel, wire_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDeliveryStatus:
UPDATE message SET delivery_status = ? WHERE id = ?;

deleteById:
DELETE FROM message WHERE id = ?;

deleteByConversation:
DELETE FROM message WHERE conversation_id = ?;

deleteAll:
DELETE FROM message;

-- Retention: drop everything older than a cutoff (age-based sweep).
deleteOlderThan:
DELETE FROM message WHERE timestamp < ?;

-- Retention: keep only the newest :keep rows of a conversation, delete the rest.
-- LIMIT -1 OFFSET :keep skips the newest :keep rows and returns the older tail to delete.
deleteBeyondCapForConversation:
DELETE FROM message WHERE id IN (
    SELECT id FROM message
    WHERE conversation_id = :conversationId
    ORDER BY timestamp DESC
    LIMIT -1 OFFSET :keep
);
