-- Migration v5 -> v6: add the geohash bulletin-board table (signed public posts + tombstones, 0x23).
-- Existing installs keep their data; this only adds the new table. Fresh installs get it from
-- Board.sq via Schema.create instead. The two definitions must stay identical.
CREATE TABLE board_entry (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    kind          INTEGER NOT NULL,
    post_id       BLOB    NOT NULL,
    author_key    BLOB    NOT NULL,
    geohash       TEXT    NOT NULL DEFAULT '',
    content       TEXT    NOT NULL DEFAULT '',
    nickname      TEXT    NOT NULL DEFAULT '',
    created_at    INTEGER NOT NULL DEFAULT 0,
    expires_at    INTEGER NOT NULL DEFAULT 0,
    flags         INTEGER NOT NULL DEFAULT 0,
    signature     BLOB    NOT NULL,
    deleted_at    INTEGER NOT NULL DEFAULT 0,
    retain_until  INTEGER NOT NULL DEFAULT 0,
    is_orphan     INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX board_post_id ON board_entry(post_id);
